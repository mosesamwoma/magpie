DOWNLOAD_DIR=downloads
MAX_FILESIZE_MB=500
CLEANUP_AFTER_MINUTES=30
FLASK_PORT=5000
FLASK_DEBUG=False

# Optional, and only needed if YouTube starts showing "Please sign in"
# errors. Pick ONE of the two below (COOKIES_FILE wins if both are set):

# Path to a Netscape-format cookies.txt, exported from any browser.
# Portable across OS/browser — works on a server too. Recommended.
COOKIES_FILE=

# Read cookies live from a browser installed on THIS machine.
# Set to "auto" to try every major browser automatically, or to one
# specific name: "chrome", "firefox", "edge", "brave", "chromium", etc.
# Desktop-only convenience — ignored if COOKIES_FILE is set.
COOKIES_FROM_BROWSER=auto
