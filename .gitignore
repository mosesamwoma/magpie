# Python
__pycache__/
*.py[cod]
*$py.class
*.so
# Virtual environments
venv/
.venv/
env/
ENV/
# Environment variables — never commit real secrets/config, keep the example
.env
.env.*
!.env.example
# Runtime downloads (per-user data, not source)
downloads/*
!downloads/.gitkeep
data/*
!data/.gitkeep
# Packaging / build artifacts
build/
dist/
*.egg-info/
# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
# OS cruft
.DS_Store
Thumbs.db
# Logs
*.log
.kilo/